# Server Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT / Auth
JWT_SECRET=change_this_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE=604800000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Setup (used only by createAdmin.js script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_before_running_setup

# SMTP (optional — contact form emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Contact emails
CONTACT_RECEIVER_EMAIL=ranjitsharma76088@gmail.com
CONTACT_FROM_EMAIL=noreply@yourportfolio.com
