# Dependencies
node_modules/
*/node_modules/

# Production build outputs
dist/
client/dist/
dist-ssr/

# Environment files (never commit secrets)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.env.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploads & User generated media (preserve directory structure via .gitkeep)
server/uploads/*
!server/uploads/.gitkeep
client/public/uploads/*
!client/public/uploads/.gitkeep

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
